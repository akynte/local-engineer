{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akynte/local-engineer/schemas/workspace.schema.json",
  "title": "Workspace identity pin",
  "description": ".le/workspace.yaml (design v3 §2.1). Commit this file: moving the directory without it creates a new workspace on purpose, and `le workspace adopt` re-binds an existing id after a move.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scheme_version", "id", "name"],
  "properties": {
    "scheme_version": {
      "type": "integer",
      "minimum": 1,
      "description": "The id derivation scheme. Versioned so a migration command can re-key."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z2-7]{26}$",
      "description": "base32(sha256(canonical_root || git_remote || name))[:26]."
    },
    "name": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "derived_from": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_root": { "type": "string" },
        "git_remote": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "description": "Relative to the workspace root." },
          "remote": { "type": "string" },
          "default_branch": { "type": "string" }
        }
      }
    }
  }
}
